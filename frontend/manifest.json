{
    "manifest_version": 3,
    "name": "Job Match Scorer",
    "version": "1.0.0",
    "description": "Calculates job description match score",
    "permissions": [
      "activeTab",
      "scripting",
      "storage"
    ],
    
    "host_permissions": [
      "<all_urls>"
    ],
    "action": {
      "default_popup": "popup.html"
    },
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "run_at": "document_idle"
      }
    ]
  }